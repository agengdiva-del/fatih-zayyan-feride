rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'aluncell@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidAvatar(avatarId) {
      return avatarId in ['fatih', 'zayyan', 'feride', 'bintang', 'zahra'];
    }

    function isValidSubject(subjectId) {
      return subjectId in ['bahasa-indonesia', 'matematika', 'ipa', 'ips', 'bahasa-inggris', 'seni-budaya'];
    }

    function isValidPhoto(data) {
      return !('customPhotoUrl' in data)
        || data.customPhotoUrl == null
        || (
          data.customPhotoUrl is string
          && data.customPhotoUrl.size() <= 60000
          && data.customPhotoUrl.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
        );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'avatarId', 'grade', 'gradeNumber',
        'daerah', 'sekolah', 'xp', 'weeklyProgress', 'badgesCount',
        'certificatesCount', 'completedTopics', 'unlockedBadges', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'displayName', 'avatarId', 'customPhotoUrl', 'grade', 'gradeNumber',
        'daerah', 'sekolah', 'xp', 'weeklyProgress', 'badgesCount',
        'certificatesCount', 'completedTopics', 'unlockedBadges', 'updatedAt'
      ])
      && isValidPhoto(data)
      && isValidId(data.uid)
      && data.uid == request.auth.uid
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
      && data.avatarId is string && isValidAvatar(data.avatarId)
      && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 24
      && data.gradeNumber is int && data.gradeNumber >= 1 && data.gradeNumber <= 6
      && data.daerah is string && data.daerah.size() >= 2 && data.daerah.size() <= 50
      && data.sekolah is string && data.sekolah.size() >= 2 && data.sekolah.size() <= 60
      && data.xp is int && data.xp >= 0 && data.xp <= 1000000
      && data.weeklyProgress is int && data.weeklyProgress >= 0 && data.weeklyProgress <= 100
      && data.badgesCount is int && data.badgesCount >= 0 && data.badgesCount <= 500
      && data.certificatesCount is int && data.certificatesCount >= 0 && data.certificatesCount <= 500
      && data.completedTopics is list && data.completedTopics.size() <= 50
      && (data.completedTopics.size() == 0 || data.completedTopics[0] is string)
      && data.unlockedBadges is list && data.unlockedBadges.size() <= 20
      && (data.unlockedBadges.size() == 0 || data.unlockedBadges[0] is string)
      && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'avatarId', 'grade', 'gradeNumber',
        'daerah', 'sekolah', 'xp', 'badgesCount', 'updatedAt'
      ]) && data.keys().hasOnly([
        'uid', 'displayName', 'avatarId', 'customPhotoUrl', 'grade', 'gradeNumber',
        'daerah', 'sekolah', 'xp', 'badgesCount', 'updatedAt'
      ])
      && isValidPhoto(data)
      && isValidId(data.uid)
      && (data.uid == request.auth.uid || isAdmin())
      && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40
      && data.avatarId is string && isValidAvatar(data.avatarId)
      && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 24
      && data.gradeNumber is int && data.gradeNumber >= 1 && data.gradeNumber <= 6
      && data.daerah is string && data.daerah.size() >= 2 && data.daerah.size() <= 50
      && data.sekolah is string && data.sekolah.size() >= 2 && data.sekolah.size() <= 60
      && data.xp is int && data.xp >= 0 && data.xp <= 1000000
      && data.badgesCount is int && data.badgesCount >= 0 && data.badgesCount <= 500
      && data.updatedAt is timestamp;
    }

    function isValidQuizDoc(data) {
      return data.keys().hasAll([
        'id', 'subjectId', 'gradeNumber', 'topicTitle',
        'prompt', 'options', 'correctIndex', 'explanation'
      ]) && data.keys().hasOnly([
        'id', 'subjectId', 'gradeNumber', 'topicTitle',
        'prompt', 'options', 'correctIndex', 'explanation'
      ])
      && isValidId(data.id)
      && data.subjectId is string && isValidSubject(data.subjectId)
      && data.gradeNumber is int && data.gradeNumber >= 1 && data.gradeNumber <= 6
      && data.topicTitle is string && data.topicTitle.size() >= 1 && data.topicTitle.size() <= 60
      && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 280
      && data.options is list && data.options.size() >= 2 && data.options.size() <= 4
      && data.options[0] is string
      && data.correctIndex is int && data.correctIndex >= 0 && data.correctIndex < data.options.size()
      && data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 300;
    }

    // Connection ping document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Private student profile
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isVerified() && isValidId(userId) && request.auth.uid == userId
        && isValidUserProfile(incoming()) && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarId', 'customPhotoUrl', 'grade', 'gradeNumber',
          'daerah', 'sekolah', 'xp', 'weeklyProgress', 'badgesCount',
          'certificatesCount', 'completedTopics', 'unlockedBadges', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Public online leaderboard (Umum, Daerah, Sekolah) - no PII
    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId)
        && resource.data.xp is int && resource.data.xp >= 0
        && resource.data.gradeNumber is int && resource.data.gradeNumber >= 1 && resource.data.gradeNumber <= 6;
      allow list: if resource.data.xp >= 0 && request.query.limit <= 100;
      allow create: if isVerified() && isValidId(entryId)
        && (entryId == request.auth.uid || isAdmin())
        && isValidLeaderboardEntry(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(entryId)
        && (entryId == request.auth.uid || isAdmin())
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarId', 'customPhotoUrl', 'grade', 'gradeNumber',
          'daerah', 'sekolah', 'xp', 'badgesCount', 'updatedAt'
        ]);
      allow delete: if isVerified() && isValidId(entryId) && (entryId == request.auth.uid || isAdmin());
    }

    // SD Quiz Database (Kelas 1-6)
    match /quizzes/{quizId} {
      allow get: if isValidId(quizId)
        && resource.data.gradeNumber is int && resource.data.gradeNumber >= 1 && resource.data.gradeNumber <= 6;
      allow list: if resource.data.gradeNumber >= 1 && resource.data.gradeNumber <= 6;
      allow create, update: if isAdmin() && isValidId(quizId) && isValidQuizDoc(incoming());
      allow delete: if isAdmin() && isValidId(quizId);
    }
  }
}
